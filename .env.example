# Copiá este archivo como .env.  NUNCA subas .env a GitHub (está en .gitignore).
#
# Configuración por defecto: 100 % LOCAL y GRATIS con Ollama (sin API keys).
# Requiere:  ollama pull bge-m3      (embeddings)
#            ollama pull qwen2.5:7b  (LLM)

# ---------------------------------------------------------------- LLM
LLM_PROVIDER=openai
# Ollama expone una API compatible con OpenAI en esta dirección:
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama          # Ollama no la valida; cualquier texto sirve
OPENAI_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0              # 0 = respuestas más consistentes y fieles al contexto
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=120                # los modelos locales pueden tardar más
LLM_OUTPUT_RETRIES=3           # reintentos si el JSON de salida es inválido

# Para usar la API oficial de OpenAI: borrá OPENAI_BASE_URL, poné tu key real
# y OPENAI_MODEL=gpt-4o-mini.  Para Anthropic: LLM_PROVIDER=anthropic y ANTHROPIC_API_KEY.

# ---------------------------------------------------------------- Embeddings
# Deben ser los MISMOS para indexar y para consultar (el sistema lo verifica).
EMBEDDINGS_PROVIDER=ollama     # ollama | openai
EMBEDDINGS_MODEL=bge-m3        # con openai: text-embedding-3-small
# EMBEDDINGS_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------- RAG
RAG_DATA_DIR=data
RAG_PERSIST_DIR=vectorstore
RAG_COLLECTION=orion_docs
RAG_CHUNK_SIZE=500             # tokens por fragmento (mínimo 500, según la consigna)
RAG_CHUNK_OVERLAP=50           # tokens compartidos entre fragmentos consecutivos
RAG_TOP_K=4                    # fragmentos enviados al LLM (entre 3 y 5)
# RAG_TOKENIZER=aproximado     # sólo sin internet: cuenta 1 token ≈ 4 caracteres en vez de usar tiktoken

LOG_LEVEL=WARNING              # INFO muestra qué fragmentos se recuperan
